# Copy this file to .env before docker compose.

# Kanitel runtime
KANITEL_AGENT_RUNNER=docker
KANITEL_AGENT_POLL_INTERVAL_SECONDS=20
KANITEL_AGENT_TIMEOUT_MINUTES=30
KANITEL_PUBLIC_API_URL=http://host.docker.internal:8080
KANITEL_DOCKER_ADD_HOST_GATEWAY=true
KANITEL_DOCKER_WORKSPACE_MODE=copy
KANITEL_DOCKER_NPM_CACHE_VOLUME=kanitel-agent-npm-cache
KANITEL_AGENT_PROMPT_MAX_CHARS=120000
KANITEL_AGENT_PROMPT_MAX_COMMENTS=100
KANITEL_AGENT_PROMPT_SYSTEM_MAX_CHARS=12000
KANITEL_AGENT_PROMPT_COMMENT_MAX_CHARS=6000
KANITEL_AGENT_PROMPT_DESCRIPTION_MAX_CHARS=20000

# Agent list.
# Add as many blocks as you need: AGENT_0_*, AGENT_1_*, AGENT_2_* ...
# Supported providers include: codex, anthropic, openai, gemini, github-models,
# github, ollama, lmstudio, openrouter, deepseek, groq, together, mistral, xai,
# custom. Use github-models for regular GitHub PAT tokens; github is Copilot OAuth.
# API_KEY is forwarded from the Kanitel host process to the agent container.
# API_KEY_ENV is optional; leave it blank to use the provider default.

AGENT_0_NAME=
AGENT_0_PROVIDER=
AGENT_0_API_URL=
AGENT_0_API_KEY=
AGENT_0_API_KEY_ENV=
AGENT_0_MODEL=
AGENT_0_TEMPLATE=
AGENT_0_AVATAR_URL=
AGENT_0_CONTAINER_IMAGE=
AGENT_0_COMMAND=
AGENT_0_SYSTEM_PROMPT=
AGENT_0_ENABLED=
AGENT_0_ENV_0_KEY=
AGENT_0_ENV_0_VALUE=

AGENT_1_NAME=
AGENT_1_PROVIDER=
AGENT_1_API_URL=
AGENT_1_API_KEY=
AGENT_1_API_KEY_ENV=
AGENT_1_MODEL=
AGENT_1_TEMPLATE=
AGENT_1_AVATAR_URL=
AGENT_1_CONTAINER_IMAGE=
AGENT_1_COMMAND=
AGENT_1_SYSTEM_PROMPT=
AGENT_1_ENABLED=
AGENT_1_ENV_0_KEY=
AGENT_1_ENV_0_VALUE=
